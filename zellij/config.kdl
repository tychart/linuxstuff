keybinds {
    normal {
        bind "Ctrl c" { SmartCopy; }
    }

    scroll {
        bind "Ctrl c" { SmartCopy; }
    }

    shared_except "locked" {
        bind "Alt y" {
            Run "yazi" {
                floating true
                close_on_exit true
            }
        }
        bind "Alt [" { FocusGuestSession; }
        bind "Alt ]" { FocusHostSession; }
    }
}

// Disables copy on select in favor of SmartCopy
copy_on_select false

// Removes startup tips
show_startup_tips false

// Automatically control nested sessions when focused
nested_session_handling "descend"

theme "ao"

// Comment the following line if not using fish instead of default shell
default_shell "fish"
